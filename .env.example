# Copy to .env and fill in. NEVER commit .env (it holds the HMAC secret + salt).
# The HMAC secret is issued once at agent registration (dashboard -> Rotate Secret).
PORT=3000
AGENT_GAMES_HMAC_SECRET=
# Committed strategy (must match the dashboard strategy commitment):
# [extractAmount 1..10, fortifyThreshold, extractThreshold, mode 0=extract/1=hold, 0,0,0,0]
AGENT_STRATEGY_PARAMS=[10,30,0,0,0,0,0,0]
# Salt for the Poseidon commitment. Generated at build time; keep it secret-ish.
AGENT_STRATEGY_SALT=
# Must match the registered commitment; server refuses to start on mismatch.
AGENT_COMMITMENT=
AGENT_CIRCUIT_VERSION=1
# Optional Kurier (on-chain verification). Disabled unless both are set.
# KURIER_API_KEY=
# KURIER_API_URL=
# KURIER_CHAIN_ID=
