# Local-only files — not deployed to Vercel.
# server.js MUST be excluded: Vercel treats a root server.js as the
# entrypoint ("Using server.js as the root entrypoint"), which breaks the
# api/ serverless functions. The Vercel adapter (api/index.js) uses
# lib/core.js instead and never imports server.js.
